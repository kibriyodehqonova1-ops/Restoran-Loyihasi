@model Restoran_Loyiha.Models.BizHaqimizda

@{
    Layout = "_Layout";
}

<main class="main p-3">

    <div class="topbar d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Biz haqimizda</h3>
            <small class="text-muted">Restoran haqida ma’lumotlar</small>
        </div>
        <div>
            @if (Model == null || Model.Id == 0)
            {
                <a class="btn btn-success" asp-area="Admin" asp-controller="AdminHome" asp-action="EditBizHaqimizda">
                    <i class="fa fa-plus me-1"></i> Add
                </a>
            }
            else
            {
                <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminHome"  asp-action="EditBizHaqimizda" asp-route-id="@Model.Id">
                    <i class="fa fa-edit me-1"></i> O‘zgartirish
                </a>
            }
        </div>
    </div>

    <div class="card-dash p-3">
        @if (Model != null && Model.Id != 0)
        {
            <table class="table table-striped table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Sarlavha</th>
                        <th>Tavsif</th>
                        <th>Tajriva Yili</th>
                        <th>Oshpazlar Soni</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.Id</td>
                        <td>@Model.Sarlavha</td>
                        <td>@Model.Tavsif</td>
                        <td>@Model.TajribaYil</td>
                        <td>@Model.OshpazlarSoni</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted">
                Ma’lumot topilmadi
            </div>
        }
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
