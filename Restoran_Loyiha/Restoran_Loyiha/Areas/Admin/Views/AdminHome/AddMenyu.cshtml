@model Restoran_Loyiha.Models.ViewModels.CreateMenyuVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
}

    <main class="main">

        <div class="topbar">
            <div>
                <h3 class="mb-0">Yangi Menyu</h3>
                <small class="text-muted">Restorandagi menyuga yangi taom qo‘shish</small>
            </div>
            <a asp-area="Admin" asp-controller="AdminHome" asp-action="Menyu" class="btn btn-accent">
                <i class="fa fa-arrow-left me-1"></i> Orqaga
            </a>
        </div>

        <div class="card-dash" style="max-width:600px;">
            <form asp-area="Admin"
                  asp-controller="AdminHome"
                  asp-action="AddMenyu"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Nomi</label>
                    <input asp-for="Nomi" class="form-control" required />
                    <span asp-validation-for="Nomi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tavsif</label>
                    <textarea asp-for="Tavsif" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Tavsif" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Narx</label>
                    <input asp-for="Narx" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="Narx" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Oshpaz</label>
                    <select asp-for="OshpazId" class="form-control" asp-items="@(ViewBag.Oshpazlar)">
                        <option value="">-- Oshpazni tanlang --</option>
                    </select>
                    <span asp-validation-for="OshpazId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rasm</label>
                    <input asp-for="RasmUrl" type="file" class="form-control" />
                    <span asp-validation-for="RasmUrl" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-accent"><i class="fa fa-save me-1"></i> Saqlash</button>
            </form>
        </div>

    </main>

