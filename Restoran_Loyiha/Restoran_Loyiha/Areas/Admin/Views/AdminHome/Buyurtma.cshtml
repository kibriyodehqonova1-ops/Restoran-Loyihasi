@using Restoran_Loyiha.Models
@using Restoran_Loyiha.Models.ViewModels
@model List<Restoran_Loyiha.Models.ViewModels.BuyurtmaListVM>
@{
    Layout = "_Layout";
}

<main class="main p-3">

    <div class="topbar d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Buyurtmalar</h3>
            <small class="text-muted">Bugungi buyurtmalar ro‘yxati</small>
        </div>
        <div>
            <a class="btn btn-success" asp-action="AddBuyurtma">
                <i class="fa fa-plus me-1"></i> Buyurtma qo‘shish
            </a>
        </div>
    </div>

    <div class="card-dash p-3">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Rasm</th>
                        <th>Buyurtma</th>
                       
                        <th>Summa</th>
                        <th>Amallar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <img src="@b.TaomRasm" alt="@b.Taom" width="60" class="rounded" onerror="this.src='/images/no-image.png'" />
                            </td>
                            <td>@b.Taom</td>
                           
                            <td>@b.Summa.ToString()</td>
                            <td>
                                <form asp-action="EditBuyurtma" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm mb-1">O'zgartirish</button>
                                </form>
                                <form asp-action="DeleteBuyurtma" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm mb-1" onclick="return confirm('Rostdan o‘chirmoqchimisiz?')">O‘chirish</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>

<!-- Bootstrap JS (optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
