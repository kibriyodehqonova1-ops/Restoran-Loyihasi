@model Restoran_Loyiha.Models.ViewModels.CreateOshpazVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
}

    <main class="main">

        <div class="topbar">
            <div>
                <h3 class="mb-0">Yangi Oshpaz</h3>
                <small class="text-muted">Restorandagi oshpazlar ro‘yxatiga qo‘shish</small>
            </div>
            <a asp-area="Admin" asp-controller="AdminHome" asp-action="Oshpazlar" class="btn btn-accent">
                <i class="fa fa-arrow-left me-1"></i> Orqaga
            </a>
        </div>

        <div class="card-dash" style="max-width:600px;">
            <form asp-area="Admin"
                  asp-controller="AdminHome"
                  asp-action="AddOshpazlar"
                  method="post"
                  enctype="multipart/form-data">



                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Ism</label>
                    <input asp-for="Ism" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Familiya</label>
                    <input asp-for="Familiya" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Lavozim</label>
                    <input asp-for="Lavozim" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tajriba Yillari</label>
                    <input asp-for="TajribaYillari" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Rasm</label>
                    <input type="file" name="RasmUrl" class="form-control" />

                </div>

                <button class="btn btn-accent"><i class="fa fa-save me-1"></i> Saqlash</button>
            </form>
        </div>

    </main>

