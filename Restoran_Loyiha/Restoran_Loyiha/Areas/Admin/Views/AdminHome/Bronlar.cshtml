@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Restoran_Loyiha.Models
@model List<Bron>

@{
    Layout = "_Layout";
}

<main class="main">

    <div class="topbar d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Bronlar</h3>
            <small class="text-muted">B archa bronlar ro‘yxati</small>
        </div>
        <div>
            <a class="btn btn-success" asp-area="Admin" asp-controller="AdminHome" asp-action="AddBron">
                <i class="fa fa-plus me-1"></i> Bron qo‘shish
            </a>
        </div>
    </div>

    <div class="card-dash p-3">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mijoz</th>
                        <th>Email</th>
                        <th>Stol</th>
                        <th>Sana</th>
                        <th>Vaqt</th>
                        <th>Holat</th>
                        <th>Amal</th>


                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>@b.MijozIsm</td>
                            <td>@b.Email</td>
                            <td>@b.Stol.StolRaqami</td>
                            <td>@b.Sana.ToString("yyyy-MM-dd")</td>
                            <td>@b.Vaqt</td>
                            <td>@b.Holat</td>
                            <td>
                                <form asp-action="DeleteBron" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm mb-1" onclick="return confirm('Rostdan o‘chirmoqchimisiz?')">O‘chirish</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</main>

<!-- Bootstrap JS (optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
