@model Restoran_Loyiha.Models.AsosiySahifa

@{
    Layout = "_Layout";
}

<main class="main p-3">

    <div class="topbar d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Asosiy Sahifa</h3>
            <small class="text-muted">Home sahifadagi asosiy ma’lumotlar</small>
        </div>
        <div>
            @if (Model == null || Model.Id == 0)
            {
                <a class="btn btn-success" asp-action="EditAsosiySahifa">
                    <i class="fa fa-plus me-1"></i> Add
                </a>
            }
            else
            {
                <a class="btn btn-primary" asp-action="EditAsosiySahifa" asp-route-id="@Model.Id">
                    <i class="fa fa-edit me-1"></i> O‘zgartirish
                </a>
            }
        </div>
    </div>

    <div class="card-dash p-3">
        @if (Model != null && Model.Id != 0)
        {
            <table class="table table-striped table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Sarlavha</th>
                        <th>Tavsif</th>
                        <th>Rasm</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.Id</td>
                        <td>@Model.Sarlavha</td>
                        <td>@Model.Tavsif</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.RasmUrl))
                            {
                                <img src="@Model.RasmUrl" alt="Rasm" class="img-fluid" style="max-width:150px;" />
                            }
                            else
                            {
                                <span class="text-muted">Rasm yo‘q</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center text-muted">
                Ma’lumot topilmadi
            </div>
        }
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
