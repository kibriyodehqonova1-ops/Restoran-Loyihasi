@model Restoran_Loyiha.Models.ViewModels.EditMenyuVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
}
    <div class="container mt-4" style="max-width:600px;">
        <h3>Taomni tahrirlash</h3>
        <hr />

        <form asp-action="EditMenyu" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EskiRasmUrl" />

            <div class="mb-3">
                <label>Nomi</label>
                <input asp-for="Nomi" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Narx</label>
                <input asp-for="Narx" type="number" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Tavsif</label>
                <textarea asp-for="Tavsif" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label>Oshpaz</label>
                <select asp-for="OshpazId" class="form-control" asp-items="@(ViewBag.Oshpazlar)">
                    <option value="">-- Oshpazni tanlang --</option>
                </select>

            </div>

            <div class="mb-3">
                <label>Hozirgi rasm</label><br />
                <img src="@Model.EskiRasmUrl" width="120" class="rounded"
                     onerror="this.src='/images/no-image.png'" />
            </div>

            <div class="mb-3">
                <label>Yangi rasm</label>
                <input asp-for="YangiRasm" type="file" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">Saqlash</button>
            <a asp-action="Menyu" class="btn btn-secondary">Orqaga</a>
        </form>
    </div>

