@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="uz">
<head>
    <style>
        .team-img img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            display: block;
        }
    </style>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Admin</title>

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --accent: #b35200; /* warm accent */
            --accent-2: #ffba66;
            --bg: #faf6f2;
            --card: #fff;
        }

        * {
            box-sizing: border-box
        }

        body {
            font-family: Inter,system-ui,Arial;
            background: var(--bg);
            margin: 0
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 250px;
            background: linear-gradient(180deg,#7a2d00,#b35200);
            color: #fff;
            padding: 28px 18px;
            box-shadow: 4px 0 30px rgba(0,0,0,0.12);
        }

            .sidebar .brand {
                font-weight: 800;
                font-size: 20px;
                letter-spacing: 0.4px
            }

            .sidebar nav a {
                display: flex;
                align-items: center;
                color: #fff;
                padding: 10px;
                border-radius: 8px;
                text-decoration: none;
                margin-bottom: 6px
            }

                .sidebar nav a:hover {
                    background: rgba(255,255,255,0.06)
                }

        .main {
            margin-left: 250px;
            padding: 28px
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-dash {
            background: var(--card);
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06)
        }

        .kpi {
            font-size: 28px;
            font-weight: 700;
            color: #333
        }

        .kpi-sub {
            color: #666;
            font-size: 13px
        }

        .menu-card img {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 8px
        }

        table thead {
            background: linear-gradient(90deg,var(--accent),var(--accent-2));
            color: white
        }

        .btn-accent {
            background: var(--accent);
            border: none;
            color: white;
            border-radius: 8px;
            padding: 8px 14px
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand mb-3">🍽Admin Panel</div>
        <p class="small mb-3 text-white-50">· Menyu · Buyurtmalar · Bron</p>

        <nav>
            <a asp-controller="AdminHome" asp-action="AsosiySahifa"><i class="fa fa-chart-line me-3"></i> Admin Panel</a>
            <a asp-controller="AdminHome" asp-action="BizHaqimizda"><i class="fa fa-chart-line me-3"></i> Biz Haqimizda</a>
            <a asp-controller="AdminHome" asp-action="Menyu"><i class="fa fa-utensils me-3"></i> Menyular</a>
            <a asp-controller="AdminHome" asp-action="Oshpazlar"><i class="brand mb-3"></i>🍽  Oshpazlar</a>
            <a asp-controller="AdminHome" asp-action="Bronlar"><i class="fa fa-calendar-check me-3"></i> Bronlar</a>
            <a asp-controller="AdminHome" asp-action="Buyurtma"><i class="fa fa-receipt me-3"></i> Buyurtmalar</a>
            <a asp-controller="AdminHome" asp-action="Stollar"><i class="fa fa-receipt me-3"></i> Stollar</a>
            <a asp-controller="AdminHome" asp-action="Aloqa"><i class="fa fa-receipt me-3"></i> Aloqa</a>
            
           

        </nav>

       
    </aside>

    @RenderBody()

</body>

</html>
